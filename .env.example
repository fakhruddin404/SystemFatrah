# FATRAH environment variables (names only — copy to .env.local and fill in real values)
#
# Public (safe to expose to the browser bundle; used by the anon Supabase client):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/seed-only secrets (MUST NOT be set in any Vercel environment or browser bundle):
# Used exclusively by the one-time local seed script (scripts/seed-products.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — legacy CSV source, used for local seeding only:
GOOGLE_SHEETS_CSV_URL=
