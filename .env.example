# Fat_Rahz Batik environment variables (names only — copy to .env.local and fill in real values)
#
# We run two Supabase projects: fatrah-staging (previews, tests, sample data) and fatrah-prod.
# On Vercel, Production maps to fatrah-prod; Preview and Development map to fatrah-staging.
# Locally, point .env.local at fatrah-staging unless you are deliberately working on production.

# --- Which project local tooling may touch ---------------------------------------------------
# REQUIRED for `npm run seed` and `npm run test:integration`; they refuse to run if it is unset.
# Use `staging` or `production` (production seeding also needs the --confirm-production flag).
SUPABASE_TARGET=

# --- Public (safe to expose to the browser bundle) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudinary cloud name. Only images under https://res.cloudinary.com/<this>/ are optimized.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# WhatsApp number for orders: digits only with country code, e.g. 60132577325.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Server-only secrets (set in Vercel Production + Preview; NEVER prefix with NEXT_PUBLIC_) --
# Cloudinary credentials: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Used only by the admin to sign uploads and delete assets.
CLOUDINARY_URL=
# Optional. Upload folder; defaults to fat-rahz/<VERCEL_ENV> so staging and prod stay separate.
CLOUDINARY_UPLOAD_FOLDER=

# --- Local only (MUST NOT be set in any Vercel environment or GitHub secret) -----------------
# Bypasses RLS. Used by the seed script and the admin-RLS integration test.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy CSV source for seeding.
GOOGLE_SHEETS_CSV_URL=
# Optional: a STAGING admin user, enables the admin lifecycle e2e test.
ADMIN_E2E_EMAIL=
ADMIN_E2E_PASSWORD=
